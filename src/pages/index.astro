---
// Arrel del lloc: redirigeix a l'idioma del navegador (ca/es/en), o al català per defecte.
import { LANGS } from '../i18n/ui';
import { pathFor } from '../i18n/utils';

const fallback = pathFor('ca', { name: 'home' });
const targets = Object.fromEntries(LANGS.map((l) => [l, pathFor(l, { name: 'home' })]));
---

<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Porfoli</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={fallback} />
    <script is:inline define:vars={{ targets, fallback }}>
      const prefs = navigator.languages || [navigator.language || ''];
      let dest = fallback;
      for (const p of prefs) {
        const code = p.toLowerCase().split('-')[0];
        if (targets[code]) {
          dest = targets[code];
          break;
        }
      }
      location.replace(dest);
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${fallback}`} /></noscript>
  </head>
  <body>
    <p><a href={fallback}>Català</a> · <a href={targets.es}>Castellano</a> · <a href={targets.en}>English</a></p>
  </body>
</html>
