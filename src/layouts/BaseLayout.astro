---
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';

import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { PROFILE } from '../config';
import { LANG_LOCALE, LANGS, type Lang } from '../i18n/ui';
import { pathFor, useTranslations, withBase, type Route } from '../i18n/utils';

interface Props {
  lang: Lang;
  route: Route;
  /** Títol de la pàgina (sense el nom; s'hi afegeix automàticament) */
  title?: string;
  description?: string;
  image?: ImageMetadata;
  type?: 'website' | 'article';
}

const { lang, route, title, description, image, type = 'website' } = Astro.props;
const t = useTranslations(lang);

const fullTitle = title ? `${title} — ${PROFILE.name}` : `${PROFILE.name} · ${t('meta.role')}`;
const desc = description ?? t('meta.description');
const site = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(pathFor(lang, route), site).href;

const ogImage = image
  ? new URL((await getImage({ src: image, width: 1200, format: 'jpg' })).src, site).href
  : new URL(withBase('og-default.jpg'), site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // S'executa abans de pintar: evita el parpelleig de tema
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.dataset.theme = theme;
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l, route), site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor('ca', route), site).href} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={withBase('sitemap-index.xml')} />
    <meta name="theme-color" content="#f6f5f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1318" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={LANG_LOCALE[lang]} />
    <meta property="og:site_name" content={PROFILE.name} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">↓</a>
    <Header lang={lang} route={route} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Animació d'aparició en fer scroll
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
