---
import type { ImageMetadata } from 'astro';
import { Image, Picture } from 'astro:assets';
import CvButtons from './CvButtons.astro';
import OpenTo from './OpenTo.astro';
import Icon from './Icon.astro';
import { PROFILE } from '../config';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  image?: { src: ImageMetadata; title: string; href: string };
  openTo?: string[];
  avatar?: ImageMetadata;
  aboutHref?: string;
}
const { lang, image, openTo = [], avatar, aboutHref } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero blueprint-grid">
  <div class="container grid">
    <div class="text">
      <div class="who">
        {
          avatar && (
            <a class="avatar" href={aboutHref} tabindex="-1" aria-hidden="true">
              <Image src={avatar} alt="" widths={[96, 192, 288]} sizes="96px" loading="eager" />
            </a>
          )
        }
        <div>
          <p class="name">{PROFILE.name}</p>
          <p class="label kicker">
            <span class="dot" aria-hidden="true"></span>
            {t('hero.kicker')}
          </p>
        </div>
      </div>
      <h1>{t('hero.title')}</h1>
      <p class="lead">{t('hero.lead')}</p>
      <div class="open-to"><OpenTo label={t('hero.openTo')} roles={openTo} /></div>
      <div class="ctas">
        <a class="btn btn--primary" href="#projectes">
          {t('hero.cta')}
          <Icon name="arrow-right" />
        </a>
        <CvButtons lang={lang} variant="compact" />
      </div>
      <p class="label place"><Icon name="map-pin" /> {PROFILE.location}</p>
    </div>

    {
      image && (
        <figure class="frame">
          <a href={image.href}>
            <Picture
              src={image.src}
              alt={image.title}
              formats={['avif', 'webp']}
              widths={[440, 880, 1320]}
              sizes="(max-width: 900px) 100vw, 440px"
              loading="eager"
              fetchpriority="high"
            />
          </a>
          <span class="dim dim-h" aria-hidden="true">
            <span class="mono">A</span>
          </span>
          <span class="dim dim-v" aria-hidden="true">
            <span class="mono">B</span>
          </span>
          <figcaption class="label">
            <span>FIG. 01</span>
            <span>{image.title}</span>
          </figcaption>
        </figure>
      )
    }
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(3rem, 7vw, 5rem);
    border-bottom: 1px solid var(--line-soft);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin-bottom: 1.6rem;
  }
  .avatar {
    flex: none;
    display: block;
    width: 96px;
    height: 96px;
    padding: 3px;
    border: 2px solid var(--orange);
    border-radius: 50%;
    background: var(--paper);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .avatar:hover {
    transform: rotate(-4deg) scale(1.04);
  }
  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }
  .name {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .kicker {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.35rem;
  }
  .dot {
    width: 8px;
    height: 8px;
    background: var(--orange);
    border-radius: 50%;
    flex: none;
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 700;
    letter-spacing: -0.035em;
  }
  .lead {
    max-width: 52ch;
    margin-top: 1.5rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-2);
  }
  .open-to {
    margin-top: 1.75rem;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 2rem;
  }
  .place {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.75rem;
  }

  .frame {
    position: relative;
    width: 100%;
    max-width: 440px;
    justify-self: center;
    margin: 0 1.75rem 3.5rem 0;
  }
  .frame a {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .frame :global(img) {
    width: 100%;
    aspect-ratio: 5 / 8; /* vertical */
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .frame a:hover :global(img) {
    transform: scale(1.03);
  }
  /* Línies de cota al voltant de la imatge */
  .dim {
    position: absolute;
    display: grid;
    place-items: center;
    color: var(--blue);
  }
  .dim-h {
    left: 0;
    right: 0;
    bottom: -1.4rem;
    height: 1px;
    background: var(--blue);
  }
  .dim-v {
    top: 0;
    bottom: 0;
    right: -1.4rem;
    width: 1px;
    background: var(--blue);
  }
  .dim::before,
  .dim::after {
    content: '';
    position: absolute;
    background: var(--blue);
  }
  .dim-h::before,
  .dim-h::after {
    top: -5px;
    width: 1px;
    height: 11px;
  }
  .dim-h::before {
    left: 0;
  }
  .dim-h::after {
    right: 0;
  }
  .dim-v::before,
  .dim-v::after {
    left: -5px;
    height: 1px;
    width: 11px;
  }
  .dim-v::before {
    top: 0;
  }
  .dim-v::after {
    bottom: 0;
  }
  .dim .mono {
    padding: 0 0.4rem;
    background: var(--paper);
    font-size: 0.7rem;
    line-height: 1;
  }
  figcaption {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 2.1rem);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.7rem;
  }
  figcaption span:last-child {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .avatar {
      width: 76px;
      height: 76px;
    }
  }
</style>
